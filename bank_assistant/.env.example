# انسخ هذا الملف إلى .env ثم عدّل القيم / Copiez ce fichier en .env puis adaptez les valeurs.

# ---------- نموذج الذكاء الاصطناعي / Modèle d'IA (any OpenAI-compatible server) ----------
# Hunyuan-A13B served with vLLM from this repository (see README):
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=tencent/Hunyuan-A13B-Instruct
LLM_API_KEY=EMPTY
# Ollama example:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b

# Deep thinking before answering (slower, more accurate). 1 = on, 0 = off
LLM_THINKING=1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=300

# ---------- البحث الدلالي (اختياري) / Recherche sémantique (optionnelle) ----------
# A multilingual embedding model lets an Arabic question find a French paragraph and vice versa.
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=bge-m3

# ---------- البحث / Recherche ----------
TOP_K=8
# "Comprehensive answer" switch in the chat: passages read for list / general questions
TOP_K_FULL=24
# Document summaries: longer documents are read in parts of this size, then combined
SUMMARY_PART_CHARS=40000
# summaries prepared at the same time (each one keeps the model busy for a while)
SUMMARY_MAX_JOBS=2
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
QUERY_REWRITE=1

# ---------- قراءة الملفات الممسوحة ضوئياً / PDF scannés (OCR) ----------
# auto = vision model if OCR_VISION_MODEL is set, otherwise Tesseract if installed | tesseract | vision | off
OCR_ENGINE=auto
OCR_LANGS=ara+fra
OCR_DPI=300
# 6 = page is one block of text (best for tables), 3 = automatic layout (two-column pages)
OCR_PSM=6
OCR_MAX_PAGES=300
# seconds per page for the vision model
OCR_TIMEOUT=120
# More accurate on numbers: a vision model served inside the bank (vLLM / Ollama), e.g. Qwen2.5-VL
# OCR_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# The vision server defaults to LLM_BASE_URL / LLM_API_KEY:
# OCR_VISION_BASE_URL=http://localhost:8001/v1
# OCR_VISION_API_KEY=EMPTY

# ---------- الأمان / Sécurité ----------
# Set to 1 when the app is served over HTTPS (recommended, required to install it on phones).
COOKIE_SECURE=0
# Set to 1 when running behind a reverse proxy (nginx, Caddy...).
TRUST_PROXY=0
SESSION_HOURS=10
IDLE_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
MAX_UPLOAD_MB=200

# ---------- عام / Général ----------
DEFAULT_LANG=ar
# APP_NAME=مساعد وثائق بنك ...
# DATA_DIR=./data
